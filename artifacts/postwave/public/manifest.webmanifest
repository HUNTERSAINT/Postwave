{
  "name": "Postwave",
  "short_name": "Postwave",
  "description": "One post. Every platform. Publish and schedule to all your social accounts.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#effaf8",
