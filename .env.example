# Railway PostgreSQL and Redis
DATABASE_URL=
REDIS_URL=

# Zernio (formerly Late)
LATE_API_KEY=
LATE_WEBHOOK_SECRET=

# Authentication and app URL
AUTH_SECRET=
APP_URL=https://your-postwave-domain.example

# Resend transactional email
EMAIL_API_KEY=
EMAIL_FROM=Postwave <no-reply@example.com>

# Paystack billing (configure the secret key on both web and worker services)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Daily USD exchange-rate provider
EXCHANGE_RATE_API_KEY=

# S3-compatible public media storage (Cloudflare R2 or equivalent)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Set to true for providers that need path-style URLs (Supabase, MinIO)
S3_FORCE_PATH_STYLE=false

# Optional: permit Postwave to use an explicitly external PostgreSQL URL
# while running inside the Replit development environment.
POSTWAVE_ALLOW_EXTERNAL_DATABASE=false

# Optional trial configuration
TRIAL_LENGTH_DAYS=7

# Comma-separated emails that become admins after signing in with a verified email.
# The admin dashboard is at /admin.
ADMIN_EMAILS=

# Public contact shown on the Privacy, Terms and Data Deletion pages
SUPPORT_EMAIL=
